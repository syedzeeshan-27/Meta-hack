# Copy to .env.local and paste your key from dev.meta.ai. Never commit .env.local.
MODEL_API_KEY=
# Optional overrides
# MODEL_BASE_URL=https://api.meta.ai/v1
# SPARK_MODEL=muse-spark-1.3

# Fireworks: the open-weight safety watcher (Muse Spark Open). Without it the watcher falls back to Muse Spark.
FIREWORKS_API_KEY=
# Or host the open-weight model yourself (modal/glimmer.py):
# WATCHER_BASE_URL=
# WATCHER_API_KEY=
# WATCHER_MODEL=

# Vercel Blob for repair cards and photos (set automatically when you add a Blob store on Vercel).
# BLOB_READ_WRITE_TOKEN=

# Optional: require this code before anyone can use the deployed app (open a page with ?code=... once).
# ACCESS_CODE=
